# Copy to .env.local and fill in. .env.local is gitignored.
#
# For LOCAL EMULATOR work these can be any non-empty strings except
# VITE_FIREBASE_PROJECT_ID, which must match the emulator project id.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to exactly "true" to route Auth/Firestore/Functions at the emulator suite.
VITE_USE_EMULATORS=false
