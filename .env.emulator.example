# Ready-to-use emulator config. Copy to .env.local to work offline:
#   cp .env.emulator.example .env.local
VITE_FIREBASE_API_KEY=emulator-api-key
VITE_FIREBASE_AUTH_DOMAIN=umuranga-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=umuranga-dev
VITE_FIREBASE_STORAGE_BUCKET=umuranga-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:emulatoronly
VITE_USE_EMULATORS=true
