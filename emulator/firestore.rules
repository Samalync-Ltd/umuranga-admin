rules_version = '2';

// LOCAL EMULATOR ONLY — see emulator/README.md.
// Derived from umuranga-mobile/firestore.rules. Divergences are marked
// ADMIN: (dashboard read access) or FIX: (a defect in the mobile rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ADMIN: the dashboard's entire read surface. Deliberately checks for the
    // boolean true, not truthiness — a claim set to the string "true" by a
    // buggy provisioning script must not grant access.
    function isAdmin() {
      // FIX: `.get('admin', false)`, not `.admin`. Reading a claim that is
      // simply absent — which it is for every non-admin — raises "Property
      // admin is undefined on object" rather than evaluating false, and an
      // erroring clause denies the whole request. Because this is the FIRST
      // branch of the matches read rule, it broke the ordinary "my matches"
      // query for every ordinary user.
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Everything Discovery needs about a candidate, denormalized onto the
    // profile document. It replaced a get() on users/{uid}: a rule that reads
    // another document can never authorize a `list`, because the path wildcard
    // is unbound during query evaluation. Rules are not filters, so the
    // candidate query repeats these clauses as where() filters.
    //
    // The owner writes `discoverable`, so the update rule pins what it may
    // say. Suspend/ban must set it to false alongside moderationVisibility
    // (Addition A1) — the read rule checks both, so a stale value alone still
    // cannot expose a hidden profile.
    function discoverableIsHonest() {
      return request.resource.data.discoverable is bool && (
        request.resource.data.discoverable == false || (
          request.resource.data.moderationVisibility == 'visible' &&
          request.resource.data.visibility == 'visible' &&
          request.resource.data.keys().hasAll([
            'firstName', 'displayAge', 'gender', 'interestedIn',
            'relationshipIntention', 'country', 'city', 'bio', 'photos'
          ]) &&
          request.resource.data.firstName is string &&
          request.resource.data.firstName.size() >= 2 &&
          request.resource.data.displayAge is int &&
          request.resource.data.displayAge >= 18 &&
          request.resource.data.gender in ['woman', 'man'] &&
          request.resource.data.interestedIn in ['women', 'men'] &&
          request.resource.data.photos is list &&
          request.resource.data.photos.size() >= 2
        )
      );
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin(); // ADMIN
      allow create: if owns(uid) &&
        request.resource.data.keys().hasOnly([
          'profileComplete', 'locale', 'isDeactivated', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.profileComplete is bool &&
        request.resource.data.isDeactivated is bool &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      // The moderation fields (A1) are absent from this list on purpose: the
      // owner must never be able to lift their own suspension. Only the Admin
      // SDK, which bypasses rules entirely, writes them.
      allow update: if owns(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profileComplete', 'locale', 'isDeactivated', 'updatedAt'
        ]) && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // NOT opened to isAdmin(): private/settings holds phoneNumber and real
      // dateOfBirth. Admin reads of those go through a callable that logs the
      // access — see FIRESTORE_SCHEMA.md, Addition A6.
      match /private/{docId} {
        allow read: if owns(uid);
        // discoveryUsage is the enforced daily-like counter. An owner-writable
        // counter is not a limit, it is a suggestion — only the recordLike
        // Cloud Function (Admin SDK, which bypasses rules) advances it.
        allow write: if owns(uid) && docId != 'discoveryUsage';

        // A `**` wildcard also matches ZERO segments, so this block covers
        // users/{uid}/private/discoveryUsage itself as well as anything
        // beneath it. The guard has to be repeated or the deny above is
        // worthless.
        match /{nested=**} {
          allow read: if owns(uid);
          allow write: if owns(uid) && docId != 'discoveryUsage';
        }
      }
    }

    match /profiles/{uid} {
      // ADMIN: without this branch a suspended profile is invisible to the
      // moderator who suspended it, because moderationVisibility is 'hidden'.
      allow read: if owns(uid) || isAdmin() || (
        signedIn() &&
        resource.data.discoverable == true &&
        resource.data.moderationVisibility == 'visible'
      );
      allow create: if owns(uid) &&
        request.resource.data.moderationVisibility == 'visible' &&
        discoverableIsHonest();
      allow update: if owns(uid) &&
        request.resource.data.moderationVisibility == resource.data.moderationVisibility &&
        discoverableIsHonest();
      allow delete: if false;
    }

    match /swipes/{uid} {
      match /given/{targetUid} {
        allow read: if owns(uid);
        // Passes only. A LIKE spends the daily allowance and can complete a
        // match, so it is written solely by the recordLike callable — a
        // client-writable like is exactly how the limit was bypassable.
        allow create, update: if owns(uid) &&
          request.resource.data.decision == 'pass';
        // Deleting your own pass IS a rewind, and rewind is Premium.
        allow delete: if false;
      }

      // The likes inbox is server-only in both directions. Its document ids
      // ARE the likers' uids, and profiles/{uid} is readable by any signed-in
      // user — so a readable inbox would hand a free viewer every liker's
      // photos whatever the UI drew. getReceivedLikes returns name and age
      // and withholds the rest.
      match /receivedFrom/{fromUid} {
        allow read, write: if false;
      }
    }

    match /blocks/{uid} {
      match /blocked/{targetUid} {
        allow list, write: if owns(uid);
        allow get: if owns(uid) || (signedIn() && targetUid == request.auth.uid);
      }
    }

    // A match is created by the recordLike callable and by nothing else.
    // The old client create was guarded by likedEachOther() /
    // repliedIcebreaker(), which read the swipe documents to prove the claim.
    // Honest as far as it went, but the check and the write were separate
    // operations, so two simultaneous likes could both pass and race — and a
    // rule cannot enforce the daily like limit that gates a like at all. The
    // callable does the read, the limit check and the write in one
    // transaction on a deterministic id.
    match /matches/{matchId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.uids); // ADMIN
      allow create: if false;
      // Unmatch goes through the unmatchUser callable: it deletes the
      // mirrored inbox entries on both sides, which neither participant may
      // touch.
      allow update: if false;
      allow delete: if false;

      // FIX: G1 — the mobile rules have no block for these subcollections, so
      // the root catch-all denies every chat read and write. Rules do not
      // cascade into subcollections; the match block above does not cover them.
      function participants() {
        return get(/databases/$(database)/documents/matches/$(matchId)).data.uids;
      }
      function isParticipant() {
        return signedIn() && request.auth.uid in participants();
      }
      function matchIsActive() {
        return get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'active';
      }

      match /messages/{messageId} {
        // ADMIN: report review needs the message that was reported.
        allow read: if isAdmin() || isParticipant();
        allow create: if isParticipant() && matchIsActive() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.sentAt == request.time &&
          request.resource.data.type in ['text', 'image'];
        // Read receipts only, and only by the recipient — a sender cannot
        // rewrite the content of a message after it has been delivered.
        allow update: if isParticipant() &&
          resource.data.senderId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      match /meta/typing {
        allow read, write: if isParticipant();
      }
    }

    match /icebreakers/{icebreakerId} {
      // ADMIN: a pre-match message is a harassment vector; moderation must see it.
      allow read: if isAdmin() ||
        (signedIn() && request.auth.uid in [resource.data.senderId, resource.data.recipientId]);
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.senderId &&
        icebreakerId == (request.resource.data.senderId + '_' + request.resource.data.recipientId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 200;
      allow update: if signedIn() &&
        request.auth.uid == resource.data.recipientId &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['replied', 'ignored'];
      allow delete: if false;
    }

    match /reports/{reportId} {
      // ADMIN: without this the Phase C queue cannot load a single row.
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      // Still nobody: resolution is a Cloud Function write via the Admin SDK.
      allow update, delete: if false;
    }

    match /entitlements/{uid} {
      allow read: if owns(uid) || isAdmin(); // ADMIN
      allow write: if false;
    }

    // Payments (A3) do not exist in the mobile app at all. Admin-read,
    // function-write. Blueprint AD05 forbids editing store transactions, so
    // there is deliberately no write path for anyone but the Admin SDK.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log (A4). Admin-readable so the dashboard can show who did what;
    // never client-writable, or the log could be forged by the thing it audits.
    match /adminAudit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rewardedAdUsage/{uid} {
      match /byType/{type} {
        allow read: if owns(uid) || isAdmin(); // ADMIN: abuse investigation
        allow write: if owns(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
